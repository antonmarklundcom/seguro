# Root-level reference of all env vars used across apps.
# Each app also has its own .env.example (apps/web, apps/api, apps/worker) —
# copy those into .env in each app directory for local dev.

# --- apps/api & apps/worker ---
DATABASE_URL=postgresql://seguro:seguro@localhost:5432/seguro
REDIS_URL=redis://localhost:6379

# --- apps/api ---
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- apps/worker ---
WORKER_CONCURRENCY=5

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
